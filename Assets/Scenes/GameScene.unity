      objectReference: {fileID: 0}
    - target: {fileID: 5481185740574712145, guid: a153359cd5dd8f84fa43091beec257c9, type: 3}
      propertyPath: m_text
      value: "OBJECTIVE:\r\nPlace blocks on the 8x8 grid to clear rows and columns
        for points!\r\n\r\nGAMEPLAY:\r\n\r\n1. PLACING BLOCKS\r\n   - Drag and drop
        the available blocks onto the grid.\r\n   - Blocks cannot be rotated, so
        plan carefully!\r\n   - You must place all three blocks to get a new set.\r\n\r\n2.
        CLEARING LINES\r\n   - Fill an entire row or column to clear it.\r\n   -
        Clear multiple lines at once for bonus points!\r\n\r\n3. GAME OVER\r\n  
        - The game ends when there is no space left on the board for the available
        blocks.\r\n\r\nTIPS:\r\n   - Think ahead before placing blocks.\r\n   - Keep
        the middle of the board clear.\r\n   - Avoid leaving tiny gaps that are hard
        to fill.\r\n   - Try to clear multiple lines at once for a higher score!"
      objectReference: {fileID: 0}
    - target: {fileID: 5481185740574712145, guid: a153359cd5dd8f84fa43091beec257c9, type: 3}
      propertyPath: m_fontSize
      value: 28
      objectReference: {fileID: 0}
    - target: {fileID: 5481185740574712145, guid: a153359cd5dd8f84fa43091beec257c9, type: 3}
      propertyPath: m_fontStyle
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5481185740574712145, guid: a153359cd5dd8f84fa43091beec257c9, type: 3}
