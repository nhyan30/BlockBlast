      objectReference: {fileID: 0}
    - target: {fileID: 5481185740574712145, guid: a153359cd5dd8f84fa43091beec257c9, type: 3}
      propertyPath: m_enableAutoSizing
      value: 0
      objectReference: {fileID: 0}
